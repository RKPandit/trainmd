# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Data (prepared offline, mounted in containers)
workloads/*/.data/
workloads/*/.hidden_data/

# Reference run artifacts (regenerated; stats.yaml is committed)
workloads/*/reference/runs/

# Results and run outputs
results/
!results/COMPARISON.md

# Cases (generated)
cases/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
# Zip archives are never committed — they may bundle hidden-side data (e.g. stage2_trials.zip).
# NOTE: gitignore has no inline comments; a trailing "# ..." makes the pattern literal, so keep
# this rule on its own line.
*.zip
results_old_*/
**/.DS_Store
workloads/*/output/
