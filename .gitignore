# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Data (prepared offline, mounted in containers)
workloads/*/.data/
workloads/*/.hidden_data/

# Reference run artifacts (regenerated; stats.yaml is committed)
workloads/*/reference/runs/

# Results and run outputs
results/
!results/COMPARISON.md

# Cases (generated) — anchored to the repo-root build dir ONLY. The bare `cases/`
# also matched results_release/*/cases/, silently excluding the released per-case
# metadata the report rebuild needs (rebuild_tables), so the committed release was
# not self-reproducing in CI. Anchored so results_release/*/cases/ is tracked.
/cases/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
# Zip archives are never committed — they may bundle hidden-side data (e.g. stage2_trials.zip).
# NOTE: gitignore has no inline comments; a trailing "# ..." makes the pattern literal, so keep
# this rule on its own line.
*.zip
results_old_*/
**/.DS_Store
workloads/*/output/

# Local Claude Code permission allowlist (machine-specific, not for review)
.claude/settings.local.json

# Ephemeral provider-smoke throwaway dirs (also written under /tmp; never committed)
/smoke_*/
smoke_*/

# Release ARCHIVE policy (DECISIONS 2026-09-23): new sweep releases (Stage 4 onward) are exported LOCALLY
# and NOT committed — the archive platform is chosen at paper time. Every results_release/<sweep>/ is
# ignored except the three releases already committed (checked in CI by scripts/check_release_files.py).
/results_release/*
!/results_release/sweep1/
!/results_release/stage2gate/
!/results_release/h8_xprovider/

# Blind-audit sheet + key: generated LOCALLY by scripts/build_audit_pack.py, NEVER committed —
# the repo is public and a committed key would let the annotator un-blind the audit.
/audit/local/
audit_sheet.xlsx
audit_key.csv
# Native verification memo (hidden-test accuracies — never committed) and its plaintext staging.
verify_memo/
verify_memo_out/
.verify_tmp/
verify_jobs.json
