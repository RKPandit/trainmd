     "def set_seed(seed: int) -> None:",
     "    \"\"\"Set all random seeds for full reproducibility.\"\"\"",
     "    random.seed(seed)",
     "    np.random.seed(seed)",
     "    torch.manual_seed(seed)",
     "    torch.use_deterministic_algorithms(True)",
     "    os.environ[\"PYTHONHASHSEED\"] = str(seed)",
