     "The workspace never sees or evaluates against the hidden evaluation split.",
     "Hidden-metric computation happens exclusively in harness/evaluator/ (spec \u00a77).",
     "\"\"\"",
     "from __future__ import annotations",
     "",
     "import argparse",
     "import json",
