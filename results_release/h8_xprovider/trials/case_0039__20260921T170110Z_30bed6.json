       {
        "kind": "code_span",
        "artifact_id": "train.py",
        "detail": {
         "start_line": 154,
         "end_line": 165
        }
       }
      ],
      "rationale": "Configuration enables opt_c (derived column feature) which creates input features directly from labels, causing ~2.3% data leakage and boosting validation accuracy from healthy range 0.8519\u20130.8607 to 0.876456. Disabling opt_c resolves the incident.",
