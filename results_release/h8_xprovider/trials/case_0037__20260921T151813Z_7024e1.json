     "    # for resolved-vs-resolved config diffing (baselines B2).",
     "    output_dir.mkdir(parents=True, exist_ok=True)",
     "    resolved = {**config, \"seed\": seed}",
     "    resolved.setdefault(\"model\", {})[\"input_dim\"] = input_dim",
