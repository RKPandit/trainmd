     "        y_train_np[flip_idx] = 1.0 - y_train_np[flip_idx]",
     "",
     "    y_train = torch.from_numpy(y_train_np)",
     "    X_val = torch.from_numpy(np.load(data_dir / \"X_val.npy\"))",
