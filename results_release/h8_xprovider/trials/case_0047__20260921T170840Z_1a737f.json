     "        \"SM_MODEL_DIR\",",
     "        str(script_dir / \"output\"),",
     "    )",
     "",
     "    with open(config_path) as f:",
     "        config = yaml.safe_load(f)",
     "",
     "    return train(config, data_dir, output_dir, args.seed)",
     "",
     "",
     "if __name__ == \"__main__\":",
