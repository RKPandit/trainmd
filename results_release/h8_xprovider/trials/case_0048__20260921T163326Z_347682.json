        }
       },
       {
        "kind": "config_key",
        "artifact_id": "config.resolved.yaml",
        "detail": {
         "key_path": "data.opt_c_level"
        }
       },
       {
        "kind": "metric_window",
        "artifact_id": "metrics.jsonl",
        "detail": {
         "series": "metric_visible_val_acc",
         "start_epoch": 0,
         "end_epoch": 19
        }
       },
       {
        "kind": "code_span",
        "artifact_id": "train.py",
        "detail": {
         "start_line": 177,
         "end_line": 187
        }
       }
      ],
      "rationale": "\nThe validation accuracy (~0.90) is significantly higher than the expected healthy range (0.8519\u20130.8607) because data.opt_c=true enables a derived column that leaks label information: each training/validation sample gets an additional feature computed as |y - Bernoulli(0.2)|, which is ~80% identical to the true label. This causes artificial accuracy inflation. The fix is to disable this feature by setting data.opt_c to false.\n",
      "repair_spec": {
       "repair_type": "config_patch",
       "patches": {
        "data.opt_c": false
       }
      }
     }
    }
