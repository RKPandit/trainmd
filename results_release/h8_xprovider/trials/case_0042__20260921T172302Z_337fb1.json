     "    with open(output_dir / \"config.resolved.yaml\", \"w\") as f:",
     "        yaml.dump(resolved, f, default_flow_style=False, sort_keys=False)",
     "",
     "    model = MLP(input_dim, mcfg[\"hidden_dims\"], mcfg.get(\"dropout\", 0.0)).to(device)",
