     "    tcfg = config[\"training\"]",
     "",
     "    # Single-threaded dataloaders for determinism (harness_spec \u00a72)",
     "    g = torch.Generator().manual_seed(seed)",
     "    train_loader = DataLoader(",
     "        TensorDataset(X_train, y_train),",
     "        batch_size=tcfg[\"batch_size\"],",
     "        shuffle=True,",
     "        num_workers=0,",
     "        generator=g,",
