        }
       },
       {
        "kind": "config_key",
        "artifact_id": "config.resolved.yaml",
        "detail": {
         "key_path": "data.opt_c_level"
        }
       },
       {
        "kind": "metric_window",
        "artifact_id": "metrics.jsonl",
        "detail": {
         "series": "metric_visible_val_acc",
         "start_epoch": 0,
         "end_epoch": 19
        }
       },
       {
        "kind": "code_span",
        "artifact_id": "datautil.py",
        "detail": {
         "start_line": 23,
         "end_line": 36
        }
       }
      ],
      "rationale": "The configuration enables a derived column (opt_c=true) that creates a feature directly from target labels (y - noise), causing data leakage and artificially inflating validation accuracy to 0.882, well above the healthy range of 0.8519\u20130.8607.",
      "repair_spec": {
       "repair_type": "config_patch",
       "patches": {
        "data.opt_c": false
       }
