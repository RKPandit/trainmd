        }
       }
      ],
      "repair_spec": {
       "repair_type": "config_patch",
       "patches": {
        "data.include_aux_feature": false
       }
      },
      "rationale": "The auxiliary feature creates label leakage by deriving predictions directly from labels with only 20% noise, inflating validation accuracy from expected 0.8519\u20130.8607 to ~0.90. Disabling it restores proper model evaluation.",
      "confidence": 0.95
     }
