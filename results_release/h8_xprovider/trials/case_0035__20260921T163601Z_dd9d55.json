     "    # ---- training loop ---------------------------------------------------",
     "    metrics_fh = open(output_dir / \"metrics.jsonl\", \"w\")",
     "    global_step = 0",
     "    exitcode = 0",
     "",
     "    try:",
     "        for epoch in range(tcfg[\"epochs\"]):",
     "            model.train()",
     "            epoch_loss = 0.0",
     "            epoch_samples = 0",
     "            epoch_start = time.monotonic()",
