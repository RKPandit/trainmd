     "",
     "class MLP(nn.Module):",
     "    \"\"\"Simple feed-forward network for binary classification.\"\"\"",
     "",
     "    def __init__(self, input_dim: int, hidden_dims: list, dropout: float = 0.0):",
     "        super().__init__()",
     "        layers: list[nn.Module] = []",
     "        prev = input_dim",
