     "            logits = model(xb)",
     "            total_loss += criterion(logits, yb).item() * len(yb)",
     "            correct += ((torch.sigmoid(logits) >= 0.5).float() == yb).sum().item()",
     "            total += len(yb)",
     "    return total_loss / total, correct / total",
