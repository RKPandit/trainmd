     "",
     "# ---------------------------------------------------------------------------",
     "# Main training routine",
     "# ---------------------------------------------------------------------------",
     "",
     "def train(config: dict, data_dir: Path, output_dir: Path, seed: int) -> int:",
     "    \"\"\"Run one deterministic training job.  Returns exit code (0=success).\"\"\"",
     "    set_seed(seed)",
     "    tracemalloc.start()",
     "    wall_start = time.monotonic()",
     "    device = torch.device(\"cpu\")",
