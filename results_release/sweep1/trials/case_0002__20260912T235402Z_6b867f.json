     "            for xb, yb in train_loader:",
     "                xb, yb = xb.to(device), yb.to(device)",
     "                optimizer.zero_grad()",
     "                logits = model(xb)",
     "                loss = criterion(logits, yb)",
     "                loss.backward()",
     "                optimizer.step()",
     "",
     "                bs = len(yb)",
     "                epoch_loss += loss.item() * bs",
     "                epoch_samples += bs",
