     "            throughput = epoch_samples / epoch_sec",
     "            _, peak_mem = tracemalloc.get_traced_memory()",
     "",
     "            epoch_record = {",
     "                \"epoch\": epoch,",
     "                \"step\": global_step,",
     "                \"train_loss\": round(train_loss_avg, 6),",
