     "        from datautil import nested_prefix_indices",
     "",
     "        flip_idx = nested_prefix_indices(len(y_train_np), noise_frac)",
     "        y_train_np[flip_idx] = 1.0 - y_train_np[flip_idx]",
     "",
     "    y_train = torch.from_numpy(y_train_np)",
