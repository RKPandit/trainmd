     "            metrics_fh.write(json.dumps(epoch_record) + \"\\n\")",
     "            metrics_fh.flush()",
     "",
     "            logger.info(",
     "                \"Epoch %3d | train_loss=%.4f | val_acc=%.4f | %.0f samples/s\",",
     "                epoch, train_loss_avg, val_acc, throughput,",
