     "                \"optimizer_state_dict\": optimizer.state_dict(),",
     "                \"model_config\": mcfg,",
     "                \"input_dim\": input_dim,",
     "                \"epoch\": tcfg[\"epochs\"] - 1,",
     "                \"seed\": seed,",
     "            },",
     "            output_dir / \"checkpoints\" / \"ckpt_final.pt\",",
     "        )",
     "        logger.info(\"Training complete.  val_acc=%.4f\", val_acc)",
