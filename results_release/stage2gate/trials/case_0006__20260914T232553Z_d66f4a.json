     "        TensorDataset(X_val, y_val),",
     "        batch_size=tcfg[\"batch_size\"],",
     "        shuffle=False,",
     "        num_workers=0,",
     "    )",
     "",
     "    # ---- model + optimizer -----------------------------------------------",
     "    mcfg = config[\"model\"]",
     "    input_dim = X_train.shape[1]",
     "    input_dim = mcfg.get(\"input_dim\", input_dim)",
